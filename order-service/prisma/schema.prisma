// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Order {
  id        Int      @id @map("_id")
  clientId  Int
  status    String
  total     Float
  products  Product[]
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  @@map("orders")
}

type Product {
  id Int
  name String
  quantity Int
  price Int
}
